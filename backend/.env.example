# Copy to .env (never committed) or set in the hosting platform. No real values belong in this file.

# restricted database role, see database/README.md; without it the backend uses a local SQLite file
DATABASE_URL=postgresql://icvsp_backend:CHANGE_ME@db.YOUR-PROJECT.supabase.co:5432/postgres
# the project URL: tokens are checked against its public keys (JWKS)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# only for a project still using the legacy shared JWT secret; leave empty otherwise
SUPABASE_JWT_SECRET=
# device provisioning and the operator dashboard, e.g. from: openssl rand -hex 32
ICVSP_ADMIN_TOKEN=CHANGE_ME
# seconds between evaluator runs in the API process; 0 if python -m icvsp_backend.worker runs separately
ICVSP_WORKER_INTERVAL_S=10
# development machines only: runs without user sign-in
# ICVSP_ALLOW_ANONYMOUS=1

# rate limits (FR-SEC-20), see "Rate limits" in README.md. On by default, except in an ICVSP_ALLOW_ANONYMOUS=1 run.
# ICVSP_RATE_LIMIT_ENABLED=1
# Behind Railway or Render every request comes from their proxy: set 1 so the real client address is taken from
# X-Forwarded-For. Leave it off (the default) if the server can be reached without the proxy, or anyone can fake it.
# ICVSP_TRUST_PROXY_HEADERS=1
# proxies in front of the server: the client address is the entry this many places from the right of the header
# ICVSP_TRUSTED_PROXY_HOPS=1
# change one limit, as requests/seconds: REPORTS HEALTH READY PAGES USER CLAIM BAD_TOKEN BAD_ADMIN_TOKEN
# ICVSP_RATE_REPORTS=600/60
