# Report demo firmware (layer on top of sdkconfig.defaults). Wi-Fi name/password and the demo seed go in the
# git-ignored sdkconfig.local (copy sdkconfig.local.example).
CONFIG_ICVSP_APP_REPORT_DEMO=y
# Check certificate dates (not-before / not-after). Off by default in ESP-IDF: without it an EXPIRED server
# certificate is accepted. Needs the clock set first (SNTP now, GNSS time on the road).
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
