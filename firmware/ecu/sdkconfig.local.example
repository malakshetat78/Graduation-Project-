# Copy to sdkconfig.local (git-ignored) and fill in. Never commit the filled-in file.
CONFIG_ICVSP_WIFI_SSID="your-network"
CONFIG_ICVSP_WIFI_PASSWORD="your-password"
# Board: the laptop's LAN address, e.g. http://192.168.1.20:8010/reports. QEMU: keep the default.
# CONFIG_ICVSP_REPORT_URL="http://192.168.1.20:8010/reports"
# Signing key: by default each ECU makes its own at first boot and keeps it in flash (NVS); nothing to set.
# Only for a demo that needs the same key on every board, choose the demo seed instead (never in production):
# CONFIG_ICVSP_KEY_DEMO_SEED=y
# CONFIG_ICVSP_DEMO_SEED_HEX=""   # 64 hex characters: python3 -c "import os; print(os.urandom(32).hex())"
