{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "prod",
      "displayName": "PRODUCTION: all-in-one ECU for the car (IMU, GNSS, camera, BLE, Wi-Fi)",
      "binaryDir": "build_prod",
      "cacheVariables": {
        "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.ecu;sdkconfig.prod;sdkconfig.local",
        "SDKCONFIG": "./build_prod/sdkconfig"
      }
    },
    {
      "name": "dev",
      "displayName": "DEVELOPMENT: all-in-one ECU with debug checks (bench only)",
      "binaryDir": "build_dev",
      "cacheVariables": {
        "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.ecu;sdkconfig.dev;sdkconfig.local",
        "SDKCONFIG": "./build_dev/sdkconfig"
      }
    },
    {
      "name": "smoke",
      "displayName": "TEST: Smoke test (board check)",
      "binaryDir": "build",
      "cacheVariables": {
        "SDKCONFIG_DEFAULTS": "sdkconfig.defaults",
        "SDKCONFIG": "./build/sdkconfig"
      }
    },
    {
      "name": "camera",
      "displayName": "TEST: T-012 camera test",
      "binaryDir": "build_camera",
      "cacheVariables": {
        "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.camera",
        "SDKCONFIG": "./build_camera/sdkconfig"
      }
    },
    {
      "name": "imu",
      "displayName": "TEST: T-010 IMU test",
      "binaryDir": "build_imu",
      "cacheVariables": {
        "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.imu",
        "SDKCONFIG": "./build_imu/sdkconfig"
      }
    },
    {
      "name": "gnss",
      "displayName": "TEST: T-014 GNSS test",
      "binaryDir": "build_gnss",
      "cacheVariables": {
        "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.gnss",
        "SDKCONFIG": "./build_gnss/sdkconfig"
      }
    },
    {
      "name": "ble",
      "displayName": "TEST: T-016 BLE test",
      "binaryDir": "build_ble",
      "cacheVariables": {
        "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.ble",
        "SDKCONFIG": "./build_ble/sdkconfig"
      }
    },
    {
      "name": "report",
      "displayName": "TEST: Signed report to the backend over Wi-Fi",
      "binaryDir": "build_report",
      "cacheVariables": {
        "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.report;sdkconfig.local",
        "SDKCONFIG": "./build_report/sdkconfig"
      }
    }
  ]
}
